# Copy to .env and adjust values. Never commit a real .env file.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-value-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
REGISTRATION_ENABLED=true

# Only needed when the app runs outside Docker (backend inside Compose uses the "postgres" hostname)
# DB_URL=jdbc:postgresql://localhost:5455/servicehub
# DB_USER=servicehub
